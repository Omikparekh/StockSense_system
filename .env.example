# ==============================================================================
# StockSense — Environment Configuration Template
# Copy this file to .env and adjust variables as appropriate for your environment.
# NEVER commit the active .env file containing live secrets to version control.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=True

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000

# Frontend URL (for CORS and reset links)
FRONTEND_URL=http://localhost:5173

# Database Connection URL
# For local dev without Postgres, SQLite fallback is supported:
# DATABASE_URL=sqlite:///./stocksense.db
# For PostgreSQL (Docker / Production / Multi-Laptop staging):
DATABASE_URL=postgresql://stocksense_user:stocksense_pass@localhost:5432/stocksense_db

# Security & Authentication (Generate random secret for production: openssl rand -hex 32)
JWT_SECRET=super_secret_stocksense_jwt_signing_key_change_in_production_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OTP Configuration (console / email simulation)
OTP_PROVIDER=console
OTP_EXPIRE_MINUTES=10

# Admin Seed Configuration (Initial Bootstrap)
INITIAL_ADMIN_EMAIL=admin@stocksense.io
INITIAL_ADMIN_LOGIN_ID=admin
INITIAL_ADMIN_PASSWORD=AdminPassword123!
